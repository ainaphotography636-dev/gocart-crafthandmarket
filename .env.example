# Default currency: USD | GBP | CAD
NEXT_PUBLIC_CURRENCY_CODE=USD

# Optional legacy symbol override (prefer NEXT_PUBLIC_CURRENCY_CODE)
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Public site URL used in notification emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Store registration email notifications (Resend) ---
# Create a key at https://resend.com and add these in Vercel Project → Settings → Environment Variables
RESEND_API_KEY=
EMAIL_FROM=Crafthand Market <onboarding@resend.dev>
ADMIN_EMAIL=hello@crafthand.market
