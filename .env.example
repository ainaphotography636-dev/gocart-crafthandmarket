# PostgreSQL (Prisma) — required for Staff RBAC persistence
# Tip: you can point these at your Supabase Postgres connection strings
# (Project Settings → Database). Example:
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth + Postgres (multi-vendor marketplace) ---
# From Connect → Framework → Next.js → App Router (browser / @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy alias (still accepted if PUBLISHABLE_KEY is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From Connect → Server / @supabase/server (backend handlers)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy alias for secret key (still accepted by createServiceClient):
# SUPABASE_SERVICE_ROLE_KEY=

# Default currency: USD | GBP | CAD
NEXT_PUBLIC_CURRENCY_CODE=USD

# Optional legacy symbol override (prefer NEXT_PUBLIC_CURRENCY_CODE)
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Public site URL used in notification emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Store registration email notifications (Resend) ---
# Create a key at https://resend.com and add these in Vercel Project → Settings → Environment Variables
RESEND_API_KEY=
EMAIL_FROM=Crafthand Market <onboarding@resend.dev>
ADMIN_EMAIL=hello@crafthand.market

# --- Cloudflare R2 product media ---
# Preferred names:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=crafthandmarket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Legacy aliases (also accepted by the app if copied from the old Vercel project):
# CLOUDFLARE_R2_ACCOUNT_ID=
# NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=
#
# Video uploads use browser PUT to R2 via presigned URLs. Enable CORS on the bucket:
# AllowedOrigins: your Vercel preview/production domains (or *)
# AllowedMethods: GET, PUT, HEAD
# AllowedHeaders: *
# ExposeHeaders: ETag
